{
  "name": "@avplan/floorplan",
  "private": true,
  "version": "1.0.0",
  "description": "Grundriss fuer alle Planer: Plan-Datei (Bild/PDF) per Auswahl oder Drag & Drop laden und verkleinern, Massstab (Zwei-Punkt, Vier-Ecken-Homographie), Venue-Austauschformat",
  "type": "module",
